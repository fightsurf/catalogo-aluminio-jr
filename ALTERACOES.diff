+<style>
+  :root{font-family:Arial,sans-serif;color:#17202a;background:#eef1f4}*{box-sizing:border-box}body{margin:0}.app{max-width:1180px;margin:0 auto;padding:18px}.topo{display:flex;justify-content:space-between;gap:14px;align-items:center;flex-wrap:wrap;margin-bottom:14px}.topo h1{margin:0;font-size:25px}.topo p{margin:5px 0 0;color:#61707f;font-size:13px}.topo a{color:#23384f;text-decoration:none;font-weight:700}.grid{display:grid;grid-template-columns:minmax(310px,420px) minmax(0,1fr);gap:16px}.painel{background:white;border:1px solid #d8dee5;border-radius:14px;padding:15px;box-shadow:0 2px 10px rgba(24,39,55,.05)}.painel h2{font-size:17px;margin:0 0 12px}.arquivo{display:block;border:2px dashed #9ca9b6;border-radius:12px;padding:16px;text-align:center;cursor:pointer;background:#f8fafb;font-weight:700}.arquivo:hover{background:#f2f5f7}.arquivo input{display:none}.arquivo small{display:block;font-weight:400;color:#6b7884;margin-top:5px}.preview-wrap{margin-top:14px;background:#111;border-radius:14px;overflow:hidden;position:relative;aspect-ratio:9/16;max-height:660px;margin-left:auto;margin-right:auto}.preview-wrap video{display:block;width:100%;height:100%;object-fit:contain;background:#000}.preview-vazio{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#cdd3d8;text-align:center;padding:20px}.overlay{position:absolute;inset:0;pointer-events:none;color:#111}.grupo-topo{position:absolute;left:5%;top:4.2%;display:flex;flex-direction:column;align-items:flex-start;gap:.55%;font-size:clamp(12px,2.2vw,20px)}.grupo-topo .nome{align-self:center;font-weight:700}.grupo-baixo{position:absolute;left:50%;top:68.7%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.55%;white-space:nowrap;font-size:clamp(13px,2.35vw,21px)}.bolha{background:rgba(255,255,255,.95);padding:.32em .55em;border-radius:.45em;box-shadow:0 1px 3px rgba(0,0,0,.12)}.metadados{margin-top:10px;font-size:12px;color:#5b6875;min-height:18px}.aviso{display:none;margin-top:10px;padding:10px 12px;border-radius:9px;font-size:13px}.aviso.show{display:block}.aviso.erro{background:#ffe9e9;color:#8a1717}.aviso.ok{background:#e8f7ed;color:#176033}.filtros{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}.cat-btn{border:1px solid #bac4ce;background:#fff;padding:7px 10px;border-radius:999px;cursor:pointer;font-size:12px}.cat-btn.active{background:#172b40;color:white;border-color:#172b40}.busca{width:100%;padding:10px 11px;border:1px solid #c6cfd8;border-radius:9px;margin-bottom:10px}.produtos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;max-height:540px;overflow:auto;padding-right:3px}.produto{border:1px solid #d6dde4;border-radius:10px;padding:9px;background:#fff;display:grid;grid-template-columns:58px minmax(0,1fr);gap:8px;align-items:center}.produto.selecionado{border-color:#1f6e46;background:#f3fbf6}.produto img{width:58px;height:58px;object-fit:contain;background:#f5f6f7;border-radius:7px}.produto-info{min-width:0}.produto-nome{font-size:12px;font-weight:700;line-height:1.2;margin-bottom:4px}.produto-preco{font-size:12px;color:#5e6872}.produto-controles{display:flex;gap:6px;align-items:center;margin-top:5px}.produto-controles input[type=checkbox]{width:18px;height:18px}.qtd{width:58px;padding:5px;border:1px solid #c8d0d8;border-radius:6px;text-align:center}.resumo{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}.resumo-card{background:#f3f6f8;border-radius:9px;padding:9px;text-align:center}.resumo-card span{display:block;font-size:11px;color:#64717d}.resumo-card strong{display:block;margin-top:3px;font-size:15px}.selecionados{font-size:12px;color:#53606c;margin:8px 0;max-height:70px;overflow:auto}.publicar{width:100%;border:0;border-radius:10px;background:#111f2e;color:white;padding:13px;font-size:15px;font-weight:700;cursor:pointer}.publicar:disabled{opacity:.5;cursor:not-allowed}.resultado{margin-top:12px;border-top:1px solid #e0e5ea;padding-top:12px}.resultado[hidden]{display:none}.canal{display:flex;justify-content:space-between;gap:8px;border-bottom:1px solid #edf0f2;padding:8px 0;font-size:13px}.status-ok{color:#19713f;font-weight:700}.status-erro{color:#a82323;font-weight:700}.detalhe-erro{font-size:11px;color:#8c3a3a;margin-top:2px}.diag{font-size:12px;color:#667582;margin-bottom:10px}.diag strong{color:#243342}.processando{margin-top:10px;background:#fff8d9;color:#6e5811;border-radius:9px;padding:10px;font-size:13px;display:none}.processando.show{display:block}@media(max-width:820px){.grid{grid-template-columns:1fr}.preview-wrap{max-height:620px;width:min(100%,350px)}.produtos{grid-template-columns:repeat(2,minmax(0,1fr));max-height:none}}@media(max-width:460px){.app{padding:10px}.produtos{grid-template-columns:1fr}.resumo{grid-template-columns:1fr 1fr}.resumo-card:last-child{grid-column:1/3}.topo h1{font-size:21px}}
