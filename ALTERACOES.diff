+      '-shortest',
+      saida,
+    ]);
+  } finally {
+    await fs.unlink(overlay).catch(() => {});
+  }
+
+  return {
+    caminho: saida,
+    duracao_segundos: Number(duracao.toFixed(2)),
+    largura: LARGURA,
+    altura: ALTURA,
+  };
+}
+
+module.exports = {
+  gerarVideoFinal,
+  DURACAO_MINIMA_SEGUNDOS,
+  DURACAO_MAXIMA_SEGUNDOS,
+  LARGURA,
+  ALTURA,
+};
