+</head>
+<body>
+<main class="app">
+  <header class="topo">
+    <div><h1>Status Vídeos</h1><p>Vídeo final para WhatsApp Status, Instagram Story, Facebook Story + Feed e YouTube Shorts.</p></div>
+    <div><a href="/whatsapp/status">← Status Zap</a></div>
+  </header>
+
+  <div class="grid">
+    <section class="painel">
+      <h2>1. Selecione o vídeo local</h2>
+      <label class="arquivo">
+        Escolher vídeo
+        <small id="arquivoNome">MP4/MOV do celular · ainda não será enviado</small>
+        <input id="videoInput" type="file" accept="video/*">
+      </label>
+      <div class="preview-wrap">
+        <video id="videoPreview" controls playsinline preload="metadata"></video>
+        <div id="previewVazio" class="preview-vazio">A prévia aparece aqui usando somente o arquivo local.</div>
+        <div class="overlay">
+          <div class="grupo-topo">
+            <div class="bolha">ZAP: 83.9.9979-2085</div>
+            <div class="bolha">Instagram: @aluminiojrpb</div>
+            <div class="bolha nome">George</div>
+          </div>
+          <div class="grupo-baixo">
+            <div class="bolha" id="ovMedio">Cada item: R$ 0,00</div>
+            <div class="bolha" id="ovTotal">Kit completo: R$ 0,00</div>
+            <div class="bolha" id="ovQtd">0 itens</div>
+          </div>
+        </div>
+      </div>
+      <div id="videoMeta" class="metadados"></div>
+      <div id="videoAviso" class="aviso erro"></div>
+    </section>
+
+    <section class="painel">
+      <h2>2. Marque os itens que aparecem no vídeo</h2>
+      <div id="diagnostico" class="diag">Verificando integrações...</div>
+      <div id="categorias" class="filtros"></div>
+      <input id="busca" class="busca" type="search" placeholder="Buscar produto...">
+      <div id="produtos" class="produtos"><p>Carregando produtos...</p></div>
+
+      <div class="resumo">
+        <div class="resumo-card"><span>Cada item</span><strong id="rMedio">R$ 0,00</strong></div>
+        <div class="resumo-card"><span>Kit completo</span><strong id="rTotal">R$ 0,00</strong></div>
+        <div class="resumo-card"><span>Quantidade</span><strong id="rQtd">0 itens</strong></div>
+      </div>
+      <div id="selecionados" class="selecionados">Nenhum item selecionado.</div>
+      <button id="publicarBtn" class="publicar" type="button" disabled>Gerar vídeo final e publicar</button>
+      <div id="processando" class="processando">Processando o vídeo com FFmpeg e publicando nos 5 destinos...</div>
+      <div id="resultado" class="resultado" hidden></div>
+    </section>
+  </div>
+</main>
+<script>
+(() => {
+  const MAX_MB = 250;
+  const MIN_SEG = 3;
+  const MAX_SEG = 60;
+  const els = Object.fromEntries([
+    'videoInput','videoPreview','previewVazio','arquivoNome','videoMeta','videoAviso','categorias','busca','produtos',
+    'ovMedio','ovTotal','ovQtd','rMedio','rTotal','rQtd','selecionados','publicarBtn','processando','resultado','diagnostico'
+  ].map(id => [id, document.getElementById(id)]));
+
+  let produtos = [];
+  let categoriaAtual = '';
+  let arquivo = null;
+  let objectUrl = '';
+  let duracao = 0;
+  let requestId = '';
+  const selecao = new Map();
+
+  const esc = valor => String(valor ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  const brl = valor => Number(valor || 0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
+  const criarId = () => `sv-${Date.now()}-${Math.random().toString(36).slice(2,10)}`;
+  const invalidarRequest = () => { requestId = ''; els.resultado.hidden = true; };
+
+  function resumo() {
+    const itens = [...selecao.values()];
+    const quantidade = itens.reduce((s,x) => s + x.quantidade, 0);
+    const total = itens.reduce((s,x) => s + x.quantidade * Number(x.produto.preco || 0), 0);
+    const medio = quantidade ? total / quantidade : 0;
+    return { itens, quantidade, total, medio };
+  }
+
+  function atualizarResumo() {
+    const r = resumo();
+    els.rMedio.textContent = brl(r.medio);
+    els.rTotal.textContent = brl(r.total);
+    els.rQtd.textContent = `${r.quantidade} ${r.quantidade === 1 ? 'item' : 'itens'}`;
+    els.ovMedio.textContent = `Cada item: ${brl(r.medio)}`;
+    els.ovTotal.textContent = `Kit completo: ${brl(r.total)}`;
+    els.ovQtd.textContent = `${r.quantidade} ${r.quantidade === 1 ? 'item' : 'itens'}`;
+    els.selecionados.textContent = r.itens.length
+      ? r.itens.map(x => `${x.quantidade}x ${x.produto.nome}`).join(' · ')
+      : 'Nenhum item selecionado.';
+    validarPublicacao();
+  }
+
+  function validarPublicacao() {
+    const r = resumo();
+    const videoOk = arquivo && duracao >= MIN_SEG && duracao <= MAX_SEG + .2 && arquivo.size <= MAX_MB * 1024 * 1024;
+    els.publicarBtn.disabled = !(videoOk && r.quantidade > 0) || els.processando.classList.contains('show');
+  }
+
+  function mostrarAvisoVideo(msg = '') {
+    els.videoAviso.textContent = msg;
+    els.videoAviso.classList.toggle('show', Boolean(msg));
+  }
+
+  function carregarArquivo(file) {
+    if (objectUrl) URL.revokeObjectURL(objectUrl);
+    arquivo = file || null; duracao = 0; invalidarRequest(); mostrarAvisoVideo('');
+    if (!arquivo) {
+      els.videoPreview.removeAttribute('src'); els.previewVazio.style.display = 'flex';
+      els.arquivoNome.textContent = 'MP4/MOV do celular · ainda não será enviado';
+      els.videoMeta.textContent = ''; validarPublicacao(); return;
+    }
+    if (!String(arquivo.type || '').startsWith('video/')) { mostrarAvisoVideo('Selecione um arquivo de vídeo válido.'); arquivo = null; validarPublicacao(); return; }
+    const mb = arquivo.size / 1024 / 1024;
+    if (mb > MAX_MB) mostrarAvisoVideo(`Vídeo muito grande: ${mb.toFixed(1)} MB. Limite: ${MAX_MB} MB.`);
+    objectUrl = URL.createObjectURL(arquivo);
+    els.videoPreview.src = objectUrl; els.previewVazio.style.display = 'none';
+    els.arquivoNome.textContent = arquivo.name;
+    els.videoMeta.textContent = `${mb.toFixed(1)} MB · prévia local, sem upload`;
+  }
+
+  els.videoInput.addEventListener('change', () => carregarArquivo(els.videoInput.files?.[0] || null));
+  els.videoPreview.addEventListener('loadedmetadata', () => {
+    duracao = Number(els.videoPreview.duration || 0);
+    const mb = arquivo ? arquivo.size / 1024 / 1024 : 0;
+    els.videoMeta.textContent = `${duracao.toFixed(1)}s · ${mb.toFixed(1)} MB · prévia local, sem upload`;
+    if (duracao < MIN_SEG) mostrarAvisoVideo(`O vídeo precisa ter pelo menos ${MIN_SEG} segundos.`);
+    else if (duracao > MAX_SEG + .2) mostrarAvisoVideo(`O vídeo tem ${duracao.toFixed(1)}s. Para Stories do Instagram/Facebook, o limite deste módulo é ${MAX_SEG}s.`);
+    else if (mb <= MAX_MB) mostrarAvisoVideo('');
+    validarPublicacao();
+  });
+
+  function renderCategorias() {
+    const mapa = new Map(produtos.filter(p => p.categoria_id).map(p => [String(p.categoria_id), p.categoria || 'Sem nome']));
+    const cats = [...mapa.entries()].sort((a,b) => a[1].localeCompare(b[1],'pt-BR'));
+    els.categorias.innerHTML = `<button class="cat-btn active" data-cat="">Todas</button>` + cats.map(([id,nome]) => `<button class="cat-btn" data-cat="${esc(id)}">${esc(nome)}</button>`).join('');
+    els.categorias.querySelectorAll('.cat-btn').forEach(btn => btn.addEventListener('click', () => {
+      categoriaAtual = btn.dataset.cat || '';
+      els.categorias.querySelectorAll('.cat-btn').forEach(x => x.classList.toggle('active', x === btn));
+      renderProdutos();
+    }));
+  }
+
+  function renderProdutos() {
+    const termo = els.busca.value.trim().toLocaleLowerCase('pt-BR');
+    const lista = produtos.filter(p => (!categoriaAtual || String(p.categoria_id) === categoriaAtual) && (!termo || String(p.nome || '').toLocaleLowerCase('pt-BR').includes(termo)));
+    els.produtos.innerHTML = lista.length ? lista.map(p => {
+      const sel = selecao.get(Number(p.id)); const q = sel?.quantidade || 1;
+      return `<article class="produto ${sel ? 'selecionado':''}" data-id="${p.id}">
+        <img src="${esc(p.foto || '/placeholder.png')}" alt="">
+        <div class="produto-info"><div class="produto-nome">${esc(p.nome)}</div><div class="produto-preco">${brl(p.preco)}</div>
+          <div class="produto-controles"><input class="check" type="checkbox" ${sel?'checked':''} aria-label="Selecionar ${esc(p.nome)}"><span>Qtd.</span><input class="qtd" type="number" min="1" max="99" value="${q}" ${sel?'':'disabled'}></div>
+        </div></article>`;
+    }).join('') : '<p>Nenhum produto encontrado.</p>';
+
+    els.produtos.querySelectorAll('.produto').forEach(card => {
+      const id = Number(card.dataset.id); const p = produtos.find(x => Number(x.id) === id);
+      const check = card.querySelector('.check'); const qtd = card.querySelector('.qtd');
+      check.addEventListener('change', () => {
+        if (check.checked) selecao.set(id,{produto:p,quantidade:Math.max(1,Number(qtd.value)||1)}); else selecao.delete(id);
+        qtd.disabled = !check.checked; card.classList.toggle('selecionado',check.checked); invalidarRequest(); atualizarResumo();
